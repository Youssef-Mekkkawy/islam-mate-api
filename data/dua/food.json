{
  "category": "food",
  "duas": [
    {
      "id": 1,
      "repeat": 1,
      "source": "Abu Dawud",
      "transliteration": "Bismillah",
      "translations": {
        "ar": {
          "text": "بِسْمِ اللَّهِ",
          "description": "يقال قبل الأكل"
        },
        "en": {
          "text": "In the name of Allah",
          "description": "Said before eating"
        }
      }
    },
    {
      "id": 2,
      "repeat": 1,
      "source": "Tirmidhi",
      "transliteration": "Alhamdulillahilladhi at'amana wa saqana",
      "translations": {
        "ar": {
          "text": "الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنَا وَسَقَانَا وَجَعَلَنَا مُسْلِمِينَ",
          "description": "يقال بعد الأكل"
        },
        "en": {
          "text": "All praise is due to Allah who fed us, gave us drink, and made us Muslims",
          "description": "Said after eating"
        }
      }
    }
  ]
