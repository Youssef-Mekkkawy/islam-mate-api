{
  "type": "sleep",
  "azkar": [
    {
      "id": 1,
      "repeat": 1,
      "source": "Bukhari",
      "transliteration": "Bismika allahumma amutu wa ahya",
      "translations": {
        "ar": {
          "text": "بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا",
          "description": "يقال عند النوم"
        },
        "en": {
          "text": "In Your name, O Allah, I die and I live",
          "description": "Said before sleeping"
        }
      }
    },
    {
      "id": 2,
      "repeat": 1,
      "source": "Bukhari",
      "transliteration": "Allahumma qini adhabak yawma tabathu ibadak",
      "translations": {
        "ar": {
          "text": "اللَّهُمَّ قِنِي عَذَابَكَ يَوْمَ تَبْعَثُ عِبَادَكَ",
          "description": "يقال ثلاث مرات عند النوم"
        },
        "en": {
          "text": "O Allah, protect me from Your punishment on the day You resurrect Your servants",
          "description": "Said three times before sleeping"
        }
      }
    }
  ]
}
